GROQ_API_KEY=your_groq_api_key_here       # Required: TTS voice (Orpheus) + LLM

# Optional overrides
GROQ_LLM_MODEL=openai/gpt-oss-120b        # Primary Groq model for chat/planning
GROQ_LLM_MODEL_SECONDARY=openai/gpt-oss-20b  # Secondary fallback model
GROQ_TIMEOUT=20                           # Per-request timeout (seconds)
OVERALL_DEADLINE=26                       # Max wall-clock time per chat request (seconds)
MAX_TOOL_ROUNDS=5
ALLOWED_ORIGINS=https://your-frontend.vercel.app
