GROQ_API_KEY=your_groq_api_key_here       # Required: TTS voice (Orpheus) + primary LLM (llama-3.3-70b-versatile)
GEMINI_API_KEY=your_gemini_api_key_here   # Optional: fallback LLM (get free at aistudio.google.com)

# Optional overrides
GROQ_LLM_MODEL=llama3-70b-8192   # Groq model for chat/planning
GEMINI_MODEL=gemini-3.8-flash             # Gemini fallback model
GEMINI_TIMEOUT=25                         # Per-request timeout for Gemini (seconds)
GROQ_TIMEOUT=20                           # Per-request timeout for Groq (seconds)
OVERALL_DEADLINE=55                       # Max wall-clock time per chat request (seconds)
MAX_TOOL_ROUNDS=5
ALLOWED_ORIGINS=https://your-frontend.onrender.com
